# Copy to .env and fill in. Real .env is gitignored — never commit actual keys.

# Bedrock / AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock model mapping — friendly name -> Bedrock model id.
BEDROCK_MODEL_MAP={"claude-sonnet":"anthropic.claude-3-5-sonnet-20241022-v2:0"}

# Finance data (Alpha Vantage)
ALPHA_VANTAGE_KEY=

# Prediction markets
# Polymarket Gamma API is public read-only, no key needed.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
